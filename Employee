.fu-icon { width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.fu-info { flex: 1; min-width: 0; }
.fu-name { font-size: 12px; font-weight: 600; }
.fu-detail { font-size: 10px; color: var(--text-secondary); margin-top: 2px; }
.fu-time { font-size: 10px; color: var(--text-muted); white-space: nowrap; }
.fu-remind-btn { padding: 4px 10px; background: rgba(45,139,255,0.1); border: 1px solid rgba(45,139,255,0.2); border-radius: 6px; color: var(--accent-blue); font-size: 10px; cursor: pointer; transition: all 0.15s; flex-shrink: 0; }
