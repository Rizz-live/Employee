// ---- RINGS ----
function animateRing(id, pct) {
  const el = document.getElementById(id);
  if(!el) return;
  const circumference = 2 * Math.PI * 27;
  const offset = circumference - (pct/100 * circumference);
  setTimeout(() => { el.style.strokeDasharray = circumference; el.style.strokeDashoffset = offset; }, 400);
}

// ---- HEATMAP ----
function buildHeatmap(id, cols) {
  const el = document.getElementById(id);
  if(!el) return;
  const levels = [0,1,2,3,4];
  let html = '';
  const count = cols === 13 ? 91 : 7;
  for(let i=0;i<count;i++) {
    const l = Math.random() < 0.3 ? 0 : levels[Math.floor(Math.random()*5)];
    html += `<div class="hm-cell hm-${l}" title="Activity level ${l}"></div>`;
  }
  el.innerHTML = html;
}

// ---- NAVIGATION ----
const sections = ['dashboard','agencies','meetings','tasks','followups','report'];

function showSection(name, navEl, tabEl) {
  sections.forEach(s => {
    const el = document.getElementById('sec-'+s);
    if(el) el.style.display = 'none';
  });
  const target = document.getElementById('sec-'+name);
  if(target) target.style.display = 'block';

  // nav highlight
  if(navEl) {
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    navEl.classList.add('active');
  }
  // tab highlight
  const tabs = document.querySelectorAll('.section-tabs .tab');
  const sectionIndex = sections.indexOf(name);
  tabs.forEach((t,i)=>t.classList.toggle('active', i===sectionIndex));
}

// MODAL
function openModal() { document.getElementById('modalOverlay').classList.add('show'); }
function closeModal() { document.getElementById('modalOverlay').classList.remove('show'); }
function closeFloating() {
  const n = document.getElementById('floatingNotif');
  n.style.transform = 'translateY(20px)'; n.style.opacity = '0';
  setTimeout(()=>n.style.display='none', 300);
}

