/* HEATMAP */
.heatmap { margin-top: 4px; }
.heatmap-grid { display: grid; grid-template-columns: repeat(13, 1fr); gap: 3px; margin-top: 6px; }
.hm-cell { aspect-ratio: 1; border-radius: 3px; transition: transform 0.15s; cursor: pointer; }
.hm-cell:hover { transform: scale(1.3); }
.hm-0 { background: rgba(255,255,255,0.05); }
.hm-1 { background: rgba(45,139,255,0.2); }
.hm-2 { background: rgba(45,139,255,0.4); }
.hm-3 { background: rgba(45,139,255,0.65); }
.hm-4 { background: var(--accent-blue); }

/* FLOATING NOTIFICATION */
.floating-notif {
  position: fixed; bottom: 24px; right: 316px;
  background: rgba(10,20,40,0.95);
  border: 1px solid rgba(45,139,255,0.3);
