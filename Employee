  const initials = ['AK','RK','PS','DS','MN'];
  return `<div class="task-avatar" style="background:${avatarColors[i%6]}">${initials[i%5]}</div>`;
}

function buildKanban() {
  const board = document.getElementById('kanbanBoard');
  board.innerHTML = kanbanData.map(col => `
    <div class="kanban-col">
      <div class="kanban-header">
        <div class="kanban-label"><div class="kanban-dot" style="background:${col.color}"></div>${col.col}</div>
        <div class="kanban-count">${col.tasks.length}</div>
      </div>
      <div class="kanban-body">
        ${col.tasks.map((t,i)=>`
          <div class="task-card" draggable="true">
            <div class="task-priority" style="background:${t.priority==='high'?'var(--accent-rose)':t.priority==='med'?'var(--accent-amber)':'var(--accent-emerald)'}"></div>
            <div class="task-title">${t.title}</div>
            <div class="task-agency"><i class="fas fa-building" style="font-size:9px;margin-right:4px;color:var(--text-muted)"></i>${t.agency}</div>
            <div class="task-footer">
              <div class="task-tags">${t.tags.map(tag=>`<span class="task-tag">${tag}</span>`).join('')}</div>
              <div class="task-avatars">${randomAvatar(i)}${i<2?randomAvatar(i+1):''}</div>
            </div>
            <div class="task-due ${t.overdue?'overdue':''}">
              <i class="fas fa-clock" style="font-size:9px"></i> ${t.overdue?'Overdue · ':''}${t.due}
