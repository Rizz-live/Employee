.modal-close:hover { color: var(--text-primary); background: var(--bg-card-hover); }

.modal-body { padding: 20px; overflow-y: auto; }

.form-group { margin-bottom: 14px; }
.form-label { font-size: 11px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block; text-transform: uppercase; letter-spacing: 0.05em; }
.form-input {
